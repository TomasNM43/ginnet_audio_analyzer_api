<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- HttpPlatformHandler: IIS lanza y gestiona el proceso uvicorn -->
    <!-- Requiere: HttpPlatformHandler instalado en IIS               -->
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="C:\inetpub\wwwroot\Ginnet_AudioVideo_Api\venv\Scripts\python.exe"
                  arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\wwwroot\Ginnet_AudioVideo_Api\logs\uvicorn.log"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:04:00"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\Ginnet_AudioVideo_Api" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- 500 MB máx para subida de archivos de audio/video -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
